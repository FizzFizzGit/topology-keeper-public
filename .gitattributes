# Keep application sources and project documentation stable across Windows and Unix.
/src/** text eol=lf
/README.md text eol=lf
/README.ja.md text eol=lf
/manifest.json text eol=lf
/package.json text eol=lf
/package-lock.json text eol=lf
/scripts/** text eol=lf
/docs/** text eol=lf

# These scripts run from Windows command shells.
/build.bat text eol=crlf
/dev.bat text eol=crlf
/env.bat text eol=crlf
/setup.bat text eol=crlf
